{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "ZMP Luxury Theme",
  "description": "Zahir MJ Property — obsidian navy + champagne gold (modern/futuristic/luxury)",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#06121D"
    },
    "bg-deep": {
      "$type": "color",
      "$value": "#030B13"
    },
    "surface": {
      "$type": "color",
      "$value": "#0B1B29"
    },
    "surface-elevated": {
      "$type": "color",
      "$value": "#102638"
    },
    "gold": {
      "$type": "color",
      "$value": "#D8B56A"
    },
    "gold-light": {
      "$type": "color",
      "$value": "#F0D28A"
    },
    "ivory": {
      "$type": "color",
      "$value": "#F5F1E8"
    },
    "text": {
      "$type": "color",
      "$value": "#F4F6F8"
    },
    "muted": {
      "$type": "color",
      "$value": "#A7B1BD"
    },
    "border": {
      "$type": "color",
      "$value": "rgba(164,193,214,0.24)"
    },
    "whatsapp": {
      "$type": "color",
      "$value": "#25D366"
    },
    "whatsapp-dark": {
      "$type": "color",
      "$value": "#128C7E"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "serif": {
      "$type": "fontFamily",
      "$value": "'Cormorant Garamond', 'Times New Roman', serif"
    }
  },
  "radius": {
    "r": {
      "$type": "dimension",
      "$value": "14px"
    },
    "r-lg": {
      "$type": "dimension",
      "$value": "20px"
    },
    "r-xl": {
      "$type": "dimension",
      "$value": "28px"
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(0,0,0,.3)"
    },
    "md": {
      "$type": "shadow",
      "$value": "0 4px 16px rgba(0,0,0,.4)"
    },
    "lg": {
      "$type": "shadow",
      "$value": "0 8px 32px rgba(0,0,0,.5)"
    }
  }
}